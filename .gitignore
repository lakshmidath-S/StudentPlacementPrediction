# ==============================
# Python
# ==============================

__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyo

# Virtual environments
.venv/
venv/
env/
ENV/

# ==============================
# IDE / Editor
# ==============================

.vscode/
.idea/

# ==============================
# Environment / Secrets
# ==============================

.env
.env.*
!.env.example
.streamlit/secrets.toml

# ==============================
# Tenant data — NEVER commit
# ==============================
#
# workspaces/ holds every organisation's uploaded data, trained models and
# prediction history. Nothing under it belongs in version control: it is other
# people's records, and a model trained on them is derived from those records.
# Override the location with PLACEMENT_AI_HOME to keep it off the repo entirely.

workspaces/

# ==============================
# OS generated files
# ==============================

.DS_Store
Thumbs.db

# ==============================
# Python tools & testing
# ==============================

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ==============================
# Logs & databases
# ==============================

*.log
*.db
*.sqlite
*.sqlite3

# ==============================
# Serialised models
# ==============================
#
# No model is committed any more — every model in this system is trained by a
# user, on their data, and lives in their workspace.

*.pkl
*.joblib
*.h5
*.keras

# ==============================
# Data
# ==============================
#
# The bundled sample is synthetic and carries no real student records, so it
# ships with the repo to give a first-time user something to train on.

data/*
!data/raw/
data/raw/*
!data/raw/synthetic_placement_dataset.csv

# ==============================
# Scratch
# ==============================

*.tmp
*.temp
prediction.txt
cognizant-hackathon-playbook (1).md
SCHEMA_MIGRATION_AUDIT.md
