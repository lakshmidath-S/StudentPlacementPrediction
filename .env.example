# Copy to .env and fill in whichever provider you have a key for.
# None are required — without one, the planner uses its rule-based fallback and
# the app still trains and predicts end to end.
#
# Reading .env needs python-dotenv (it is in requirements.txt). Without it the
# file is ignored, and the app will tell you so in the sidebar.

# Google Gemini — free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# xAI Grok — https://console.x.ai/  (the team needs credits; a keyed but
# unfunded account returns HTTP 403 and the planner falls back)
XAI_API_KEY=

# OpenRouter — https://openrouter.ai/keys  (either spelling is accepted)
OPENROUTER_API_KEY=

# auto | gemini | grok | openrouter | off      ("off" forces the rule-based planner)
LLM_PROVIDER=auto

# --- optional overrides ------------------------------------------------------
# Google retires model versions on a schedule; if a run reports a 404, set this.
# GEMINI_MODEL=gemini-3.6-flash
# Free OpenRouter model IDs are retired often — see openrouter.ai/models?max_price=0
# OPENROUTER_MODEL=minimax/minimax-m3:free

# Where tenant workspaces, models and history live.
# Point this at a persistent volume in any cloud deployment.
# PLACEMENT_AI_HOME=./workspaces
